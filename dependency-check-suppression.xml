<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
    ============================================================
    OWASP Dependency-Check False Positive Suppression File
    ============================================================

    How to add a suppression:

    Option A: Suppress by packageUrl + specific CVE
    ────────────────────────────────────────────────
    Use this when a specific CVE is a false positive for a
    particular package version.

    <suppress>
        <notes>
            CVE-XXXX-XXXXX is a false positive for this package.
            Reason: [explain why it doesn't apply, e.g. the vulnerable
            code path is not used, or the fix was backported]
            Reviewed by: [name] on [date]
        </notes>
        <packageUrl regex="false">pkg:npm/package-name@1.2.3</packageUrl>
        <cve>CVE-XXXX-XXXXX</cve>
    </suppress>


    Option B: Suppress by vulnerabilityName regex
    ──────────────────────────────────────────────
    Use this for NVD entries identified by name/pattern rather
    than a specific CVE (e.g. advisory IDs, GHSA IDs).

    <suppress>
        <notes>
            False positive — GHSA-XXXX is not applicable because [reason].
            Reviewed by: [name] on [date]
        </notes>
        <packageUrl regex="true">^pkg:npm/some-package@.*$</packageUrl>
        <vulnerabilityName regex="true">.*GHSA-xxxx-yyyy-zzzz.*</vulnerabilityName>
    </suppress>

    ============================================================
    Add active suppressions below this line
    ============================================================
    -->

    <!--
    ============================================================
    react-scripts@5.0.1 internal build-tool vulnerabilities
    ============================================================
    react-scripts 5.0.1 is the final release of Create React App and is
    effectively EOL. The packages below are internal build-time dependencies
    locked to specific versions by react-scripts. They are NOT included in
    the production Docker image — the Nginx container serves only compiled
    static assets. These suppressions cover all vulnerabilities for packages
    that cannot be upgraded without abandoning react-scripts entirely.

    Reviewed: 2026-03-13
    -->

    <!-- nth-check@2.1.1 — CVE-2021-3803 (CVSS 7.5): Inefficient RegExp in CSS nth selector
         Only used by svgo/css-select during the build step; never runs at runtime. -->
    <suppress>
        <notes>
            nth-check ReDoS (CVE-2021-3803) — build-time only.
            Locked by react-scripts@5.0.1. Not deployed to production.
            Reviewed: 2026-03-13
        </notes>
        <packageUrl regex="true">^pkg:npm/nth-check@.*$</packageUrl>
        <vulnerabilityName regex="true">.*</vulnerabilityName>
    </suppress>

    <!-- svgo@1.3.2 — build-time SVG optimiser locked by react-scripts.
         Only processes SVG files during build; never parses untrusted input at runtime. -->
    <suppress>
        <notes>
            svgo vulnerabilities — build-time SVG optimiser locked by react-scripts@5.0.1.
            Not deployed to production.
            Reviewed: 2026-03-13
        </notes>
        <packageUrl regex="true">^pkg:npm/svgo@.*$</packageUrl>
        <vulnerabilityName regex="true">.*</vulnerabilityName>
    </suppress>

    <!-- @svgr/plugin-svgo and @svgr/webpack — webpack SVG loaders locked by react-scripts.
         DC encodes scoped package names as %40svgr in packageUrl. -->
    <suppress>
        <notes>
            @svgr/plugin-svgo and @svgr/webpack are build-time webpack loaders
            locked by react-scripts@5.0.1. Not deployed to production.
            Reviewed: 2026-03-13
        </notes>
        <packageUrl regex="true">^pkg:npm/%40svgr/.*$</packageUrl>
        <vulnerabilityName regex="true">.*</vulnerabilityName>
    </suppress>

    <!-- css-select@4.3.0 — depends on nth-check, locked by react-scripts.
         Used by html-webpack-plugin at build time only. -->
    <suppress>
        <notes>
            css-select depends on nth-check@2.1.1 locked by react-scripts@5.0.1.
            Build-time only; not deployed to production.
            Reviewed: 2026-03-13
        </notes>
        <packageUrl regex="true">^pkg:npm/css-select@.*$</packageUrl>
        <vulnerabilityName regex="true">.*</vulnerabilityName>
    </suppress>

    <!-- serialize-javascript@6.0.2 — locked by react-scripts via rollup-plugin-terser/workbox.
         Only serialises developer-authored source code during build; no untrusted input. -->
    <suppress>
        <notes>
            serialize-javascript locked by react-scripts@5.0.1 via rollup-plugin-terser
            and workbox. Build-time only; not deployed to production.
            Reviewed: 2026-03-13
        </notes>
        <packageUrl regex="true">^pkg:npm/serialize-javascript@.*$</packageUrl>
        <vulnerabilityName regex="true">.*</vulnerabilityName>
    </suppress>

    <!-- rollup-plugin-terser@7.0.2 — JS minifier locked by react-scripts. Build-time only. -->
    <suppress>
        <notes>
            rollup-plugin-terser locked by react-scripts@5.0.1. Build-time only;
            not deployed to production.
            Reviewed: 2026-03-13
        </notes>
        <packageUrl regex="true">^pkg:npm/rollup-plugin-terser@.*$</packageUrl>
        <vulnerabilityName regex="true">.*</vulnerabilityName>
    </suppress>

    <!-- css-minimizer-webpack-plugin@3.4.1 — CSS minifier locked by react-scripts. Build-time only. -->
    <suppress>
        <notes>
            css-minimizer-webpack-plugin locked by react-scripts@5.0.1. Build-time only;
            not deployed to production.
            Reviewed: 2026-03-13
        </notes>
        <packageUrl regex="true">^pkg:npm/css-minimizer-webpack-plugin@.*$</packageUrl>
        <vulnerabilityName regex="true">.*</vulnerabilityName>
    </suppress>

    <!-- workbox-build@6.6.0 and workbox-webpack-plugin@6.6.0 — PWA cache plugins locked by react-scripts. -->
    <suppress>
        <notes>
            workbox-build and workbox-webpack-plugin locked to 6.6.0 by react-scripts@5.0.1.
            Build-time only; not deployed to production.
            Reviewed: 2026-03-13
        </notes>
        <packageUrl regex="true">^pkg:npm/workbox-.*$</packageUrl>
        <vulnerabilityName regex="true">.*</vulnerabilityName>
    </suppress>

    <!-- flatted@3.2.7 — locked by react-scripts@5.0.1 via eslint→file-entry-cache→flat-cache.
         Build-time ESLint dep only; never runs in the production Docker image.
         Backend flatted is fixed via npm overrides to ^3.4.0; frontend cannot be overridden
         inside react-scripts' locked dependency tree. -->
    <suppress>
        <notes>
            flatted DoS vulnerability — locked transitively by react-scripts@5.0.1 via
            eslint→file-entry-cache→flat-cache. Build-time only; not deployed to production.
            Reviewed: 2026-03-16
        </notes>
        <packageUrl regex="true">^pkg:npm/flatted@.*$</packageUrl>
        <vulnerabilityName regex="true">.*</vulnerabilityName>
    </suppress>

</suppressions>
